# Supabase Postgres — lấy ở Supabase Dashboard > Project Settings > Database
# Dùng connection string "Transaction pooler" cho DATABASE_URL (phù hợp serverless/Vercel)
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Dùng connection string "Direct connection" cho DIRECT_URL (Prisma Migrate cần kết nối trực tiếp)
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Chuỗi bí mật để ký JWT — tự tạo, ví dụ: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"
